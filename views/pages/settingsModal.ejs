<button type="button" class="rounded-lg border border-slate-500 px-3 py-2 text-sm"
  onclick="document.getElementById('settingsModal').showModal()">Voice settings</button>
<dialog id="settingsModal" class="w-full max-w-md rounded-xl border border-slate-600 bg-slate-900 p-6 text-slate-100 shadow-2xl backdrop:bg-black/70">
  <h2 class="mb-4 text-xl font-semibold">Voice settings</h2>
  <label class="mb-4 block text-sm">Voice
    <select id="voiceSelect" class="mt-2 w-full rounded bg-slate-700 p-2"></select>
  </label>
  <label class="mb-4 block text-sm">Rate <span id="rateValue">1</span>
    <input id="rateSelect" type="range" min="0.5" max="2" step="0.1" value="1" class="mt-2 block w-full">
  </label>
  <label class="mb-4 block text-sm">Pitch <span id="pitchValue">1</span>
    <input id="pitchSelect" type="range" min="0" max="2" step="0.1" value="1" class="mt-2 block w-full">
  </label>
  <form method="dialog" class="mt-6 text-right">
    <button class="rounded bg-slate-700 px-4 py-2 text-sm hover:bg-slate-600">Close</button>
  </form>
</dialog>
<script>
(() => {
  const voices = document.getElementById('voiceSelect');
  const synth = window.speechSynthesis;
  const refresh = () => {
    if (!synth) return;
    const selected = voices.value;
    voices.replaceChildren();
    for (const voice of synth.getVoices()) {
      const option = new Option(voice.name + ' (' + voice.lang + ')', voice.name);
      voices.add(option);
    }
    if (selected) voices.value = selected;
  };
  refresh();
  synth?.addEventListener?.('voiceschanged', refresh);
  for (const type of ['rate', 'pitch']) {
    const input = document.getElementById(type + 'Select');
    input.addEventListener('input', () => {
      document.getElementById(type + 'Value').textContent = input.value;
    });
  }
})();
</script>
