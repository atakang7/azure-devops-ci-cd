<button type="button" class="rounded-lg border border-slate-500 px-3 py-2 text-sm"
  onclick="document.getElementById('hotelInfoModal').showModal()">
  <%= hotel.name %> · Details
</button>
<dialog id="hotelInfoModal" class="rounded-xl border border-slate-600 bg-slate-900 p-6 text-slate-100 shadow-2xl backdrop:bg-black/70">
  <h2 class="mb-4 text-xl font-semibold"><%= hotel.name %></h2>
  <dl class="grid max-w-md grid-cols-[110px_1fr] gap-3 text-sm">
    <dt>Address</dt><dd><%= hotel.address %></dd>
    <dt>Phone</dt><dd><%= hotel.phone %></dd>
    <dt>Rating</dt><dd><%= hotel.rating %> / 5</dd>
    <dt>Price</dt><dd>$<%= hotel.price %></dd>
    <dt>Description</dt><dd><%= hotel.description %></dd>
    <dt>Facilities</dt><dd><%= hotel.facilities.join(', ') || 'None listed' %></dd>
  </dl>
  <form method="dialog" class="mt-6 text-right">
    <button class="rounded bg-slate-700 px-4 py-2 text-sm hover:bg-slate-600">Close</button>
  </form>
</dialog>
