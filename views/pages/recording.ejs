<button type="button" class="rounded-lg border border-slate-500 px-3 py-2 text-sm"
  onclick="document.getElementById('recordingModal').showModal()">Voice assistant</button>
<dialog id="recordingModal" class="w-full max-w-md rounded-xl border border-slate-600 bg-slate-900 p-6 text-slate-100 shadow-2xl backdrop:bg-black/70">
  <h2 class="mb-3 text-xl font-semibold">Voice assistant</h2>
  <p id="statusMessage" role="status" class="mb-5 text-sm text-slate-300">Press Start to record a request.</p>
  <div class="flex flex-wrap gap-3">
    <button id="startRecording" class="rounded bg-emerald-700 px-4 py-2 text-sm">Start recording</button>
    <button id="stopRecording" disabled class="rounded bg-rose-700 px-4 py-2 text-sm disabled:opacity-40">Stop</button>
    <button type="button" class="rounded bg-slate-700 px-4 py-2 text-sm"
      onclick="document.getElementById('recordingModal').close()">Close</button>
  </div>
</dialog>
<script>
(() => {
  const status = document.getElementById('statusMessage');
  const startButton = document.getElementById('startRecording');
  const stopButton = document.getElementById('stopRecording');
  let recorder = null;
  let stream = null;
  let history = '';

  startButton.addEventListener('click', async () => {
    try {
      if (!navigator.mediaDevices?.getUserMedia || !window.MediaRecorder) {
        throw new Error('Microphone recording is unsupported in this browser');
      }
      stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const chunks = [];
      recorder = new MediaRecorder(stream);
      recorder.addEventListener('dataavailable', e => { if (e.data.size) chunks.push(e.data); });
      recorder.addEventListener('stop', async () => {
        stream?.getTracks().forEach(track => track.stop());
        stream = null;
        startButton.disabled = false;
        stopButton.disabled = true;
        status.textContent = 'Processing request…';
        try {
          const payload = new FormData();
          payload.append('audio', new Blob(chunks, {type: recorder.mimeType || 'audio/webm'}), 'request.webm');
          payload.append('hotelId', '<%= hotel._id %>');
          payload.append('history', history);
          const response = await fetch('/chatbot/get-chatbot-response', { method: 'POST', body: payload });
          if (!response.ok) throw new Error('Assistant returned HTTP ' + response.status);
          const data = await response.json();
          let answer;
          try { answer = JSON.parse(data.answer); } catch { answer = { message: data.answer }; }
          history = String(answer.message || '').slice(0, 2000);
          status.textContent = history || 'No answer returned.';
          if ('speechSynthesis' in window && history) {
            const utterance = new SpeechSynthesisUtterance(history);
            utterance.rate = Number(document.getElementById('rateSelect').value);
            utterance.pitch = Number(document.getElementById('pitchSelect').value);
            const name = document.getElementById('voiceSelect').value;
            utterance.voice = speechSynthesis.getVoices().find(voice => voice.name === name) || null;
            speechSynthesis.speak(utterance);
          }
        } catch {
          status.textContent = 'Assistant unavailable. Check the speech API configuration.';
        }
      });
      recorder.start();
      startButton.disabled = true;
      stopButton.disabled = false;
      status.textContent = 'Recording…';
    } catch {
      stream?.getTracks().forEach(track => track.stop());
      stream = null;
      status.textContent = 'Microphone permission was denied or recording is unavailable.';
    }
  });

  stopButton.addEventListener('click', () => {
    if (recorder?.state === 'recording') recorder.stop();
  });
  document.getElementById('recordingModal').addEventListener('close', () => {
    if (recorder?.state === 'recording') recorder.stop();
  });
})();
</script>
