<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0f243a">
  <title><%= hotel.name %> · Guest dashboard</title>
  <style>
    :root { --ink:#142c3d; --muted:#647689; --line:#dce5eb; --surface:#fff; --bg:#f5f7f9; --sea:#147d78 }
    * { box-sizing:border-box }
    body { background:var(--bg); color:var(--ink); margin:0; font:15px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif }
    a { color:inherit }
    a:focus-visible, button:focus-visible { outline:3px solid #47b6ab; outline-offset:3px }
    .shell { max-width:1120px; margin:0 auto; padding:0 24px }
    .masthead { background:#10263a; color:#fff }
    .topbar { min-height:82px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; padding:14px 0 }
    .brand { font-weight:750; font-size:1.1rem; letter-spacing:-.015em }
    .eyebrow { font-size:.7rem; letter-spacing:.16em; text-transform:uppercase; font-weight:800; color:#72cbc0 }
    nav { display:flex; flex-wrap:wrap; align-items:center; gap:8px }
    nav button { background:transparent; border:1px solid #63778c; border-radius:7px; color:#fff; font:inherit; font-size:.81rem; padding:9px 12px; cursor:pointer; white-space:nowrap }
    nav button:hover { background:#27455e }
    .welcome { padding:64px 0 70px }
    .welcome h1 { margin:12px 0; font-size:clamp(2.2rem,6vw,3.9rem); line-height:1.12; letter-spacing:-.046em; max-width:720px }
    .welcome p { color:#c6d4e0; font-size:1.02rem; max-width:620px; margin:0 }
    .stats { display:flex; flex-wrap:wrap; gap:26px; margin-top:32px; border-top:1px solid #40556a; padding-top:20px; color:#c6d4e0; font-size:.86rem }
    .stats strong { color:#fff }
    main { padding-top:45px; padding-bottom:70px }
    h2 { font-size:1.58rem; line-height:1.25; letter-spacing:-.025em; margin:0 0 9px }
    .section-head { margin-bottom:20px }
    .section-head p { color:var(--muted); margin:0 }
    .grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px }
    .card { display:block; min-width:0; overflow-wrap:anywhere; padding:22px; border-radius:12px; background:#fff; border:1px solid var(--line); text-decoration:none; box-shadow:0 2px 8px #17304508 }
    .card .glyph { display:inline-flex; align-items:center; justify-content:center; width:46px; height:46px; border-radius:10px; background:#e8f5f2; color:#187872; font-size:1.2rem; font-weight:700 }
    .card h3 { margin:15px 0 5px; font-size:1.08rem; line-height:1.3 }
    .card p { color:var(--muted); margin:0; font-size:.91rem }
    .card .caption { display:block; margin-top:12px; color:var(--sea); font-size:.79rem; font-weight:750; text-transform:uppercase; letter-spacing:.06em }
    .card:hover { border-color:#8dbdb6; box-shadow:0 6px 18px #17304512 }
    .section { margin-top:45px }
    .price { margin-top:15px; color:var(--sea); font-weight:750 }
    .empty { border:1px dashed #b5c5d0; border-radius:12px; padding:25px; color:var(--muted) }
    footer { border-top:1px solid var(--line); color:var(--muted); padding:22px 0; font-size:.8rem }
    dialog { width:min(94vw,500px); max-height:85vh; overflow:auto; border:1px solid #8297a7; border-radius:12px; background:#142c3d; color:#fff; padding:24px; box-shadow:0 20px 80px #07152366 }
    dialog::backdrop { background:#0715239c }
    dialog h2 { font-size:1.3rem; margin-top:0 }
    dialog label { display:block; margin:16px 0; font-size:.91rem }
    dialog select, dialog input { width:100%; padding:8px; margin-top:6px; background:#2b475a; border:1px solid #638093; border-radius:6px; color:#fff }
    dialog input[type="range"] { padding:0 }
    dialog button { border:0; border-radius:7px; background:#35637a; color:#fff; padding:10px 14px; margin:3px; cursor:pointer }
    dialog button:disabled { opacity:.5; cursor:not-allowed }
    dialog dl { display:grid; grid-template-columns:95px 1fr; gap:10px; margin:0; font-size:.9rem }
    dialog dt { color:#aec5d3 }
    dialog dd { margin:0 }
    @media(max-width:820px) { .grid { grid-template-columns:repeat(2,minmax(0,1fr)) } }
    @media(max-width:540px) {
      .shell { padding:0 17px }
      .topbar { align-items:flex-start }
      .welcome { padding:45px 0 50px }
      .grid { grid-template-columns:1fr }
      main { padding-top:34px }
      nav button { padding:7px 9px; font-size:.76rem }
      .stats { gap:12px }
    }
  </style>
</head>
<body>
  <div class="masthead">
    <header class="shell topbar">
      <div class="brand"><%= hotel.name %></div>
      <nav aria-label="Guest tools">
        <%- include('../pages/recording.ejs', { hotel }) %>
        <%- include('../pages/settingsModal.ejs') %>
        <%- include('../pages/hotelDetails.ejs', { hotel }) %>
      </nav>
    </header>
    <section class="shell welcome">
      <span class="eyebrow">Guest services</span>
      <h1>Make yourself at home.</h1>
      <p>Browse services available at <%= hotel.name %>. Explore dining and entertainment, or ask the voice assistant for help.</p>
      <div class="stats">
        <span><strong><%= apps.length %></strong> applications</span>
        <span><strong><%= foods.length %></strong> food options</span>
        <span><strong><%= hotel.rating %> / 5</strong> property rating</span>
      </div>
    </section>
  </div>
  <main class="shell">
    <section aria-labelledby="apps-title">
      <div class="section-head">
        <h2 id="apps-title">Entertainment & applications</h2>
        <p>Available experiences for your stay.</p>
      </div>
      <% if (!apps.length) { %><p class="empty">No applications have been added yet.</p><% } %>
      <div class="grid">
        <% apps.forEach(function(item) { %>
          <a class="card" href="<%= /^https?:\/\//.test(item.link) ? item.link : '#' %>" target="_blank" rel="noopener noreferrer">
            <span class="glyph" aria-hidden="true">▶</span>
            <h3><%= item.name %></h3>
            <p><%= item.description %></p>
            <span class="caption"><%= item.category %></span>
          </a>
        <% }); %>
      </div>
    </section>
    <section class="section" aria-labelledby="food-title">
      <div class="section-head">
        <h2 id="food-title">Dining options</h2>
        <p>Browse what's available from the hotel.</p>
      </div>
      <% if (!foods.length) { %><p class="empty">No dining options have been added yet.</p><% } %>
      <div class="grid">
        <% foods.forEach(function(item) { %>
          <article class="card">
            <span class="glyph" aria-hidden="true">◈</span>
            <h3><%= item.name %></h3>
            <p><%= item.description %></p>
            <span class="caption"><%= item.category %></span>
            <div class="price">$<%= item.price %></div>
          </article>
        <% }); %>
      </div>
    </section>
  </main>
  <footer><div class="shell">Local hospitality technology demo · Guest services</div></footer>
</body>
</html>
